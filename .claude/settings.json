{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go run -C \"${CLAUDE_PROJECT_DIR}\" ./tools/gate agent claude-stop",
            "timeout": 600,
            "statusMessage": "Checking the work tree..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go run -C \"${CLAUDE_PROJECT_DIR}\" ./tools/gate agent claude-prompt",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
